{
  "name": "hellclock-dpsmeter",
  "private": true,
  "version": "0.0.25",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm run electron:dev\"",
    "electron:dev": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build",
    "build:exe": "npm version patch --no-git-tag-version && npm run build && electron-builder && npm run cleanup:old-releases && move dist-electron\\*.7z .",
    "cleanup:old-releases": "node -e \"const fs=require('fs');fs.readdirSync('.').filter(f=>f.endsWith('.7z')).forEach(f=>{fs.unlinkSync(f);console.log('Deleted',f);});\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.hellclock.dps",
    "productName": "Hell Clock DPS",
    "directories": {
      "output": "dist-electron"
    },
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "7z"
      ]
    }
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
